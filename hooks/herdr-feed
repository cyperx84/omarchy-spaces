#!/usr/bin/env python3
# Herdr agent status feed for the Spaces bar widget.
#
# Herdr is a terminal multiplexer that already knows what every coding agent
# in its panes is doing, so instead of a reporter hook per agent the widget
# listens to Herdr itself. This script holds Herdr's socket open, and on
# startup and after every relevant event prints one JSON line to stdout:
#
#   {"type": "herdr", "focused_workspace_id": "w35",
#    "agents": [{"pane_id", "workspace_id", "workspace_label",
#                "workspace_number", "tab_id", "agent", "status", "title",
#                "focused", "session", "state_change", "activity", "tokens",
#                "cwd", "since"}]}
#
# `status` is Herdr's agent_status verbatim (idle | working | blocked | done |
# unknown); the widget decides what earns a badge. `state_change` is Herdr's
# state_change_seq for the agent (higher is more recent, 0 when unknown), so
# the widget can list the newest change first. `activity` is Herdr's label for
# the current status (its state_labels entry, "" when none), `tokens` the
# pane's free-form metadata (model, ctx, cost, branch and the like; at most
# eight short string entries), `cwd` the pane's working directory. Herdr gives
# no time for a status change, so `since` is the unix time at which this
# script first saw the pane in its current status: a fresh start counts from
# then. Only panes running an agent are listed.
#
# Herdr not installed or not running is not an error: the script exits 0
# quietly and the widget tries again later. It also exits 0 when the server
# goes away. Pass --once to print a single snapshot and exit.
#
# Pass --demo for screenshots: no socket at all, just four made-up agents
# going through working, blocked, done and idle on a fixed 20 second loop.
# Its lines carry "demo": true, and the widget only accepts those while its
# `demo` setting is on (and never otherwise).
#
# Stdlib only, so it runs anywhere python3 does.

import json
import os
import select
import signal
import socket
import sys
import time

# Events that can change an agent's status, title or workspace. Payloads are
# ignored: each burst just triggers a fresh snapshot, which is simpler and
# can never drift from what Herdr shows. (pane.agent_status_changed needs a
# pane_id to subscribe, so pane.updated stands in for it.)
EVENTS = [
    "workspace.created", "workspace.updated", "workspace.renamed",
    "workspace.moved", "workspace.reordered", "workspace.closed",
    "pane.created", "pane.updated", "pane.moved", "pane.closed",
    "pane.exited", "pane.agent_detected",
]
# The stream spells kinds with underscores (pane_updated); compare that way.
RELEVANT = {kind.replace(".", "_") for kind in EVENTS}

# Events arrive in bursts (subscribing alone replays a backlog). The first
# event opens a short window; everything inside it shares one snapshot.
DEBOUNCE = 0.15
# A working agent updates its pane about ten times a second (the title
# spinner), so snapshots are also kept at least this far apart.
MIN_GAP = 1.0


def socket_path():
    return os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser("~/.config/herdr/herdr.sock")


def connect():
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(socket_path())
    return sock


def send(sock, request_id, method, params=None):
    message = {"id": request_id, "method": method, "params": params or {}}
    sock.sendall((json.dumps(message) + "\n").encode())


def snapshot():
    # One short-lived connection per request keeps replies out of the event
    # stream. Returns None when Herdr answers with an error.
    with connect() as sock:
        sock.settimeout(5)
        send(sock, "spaces-snapshot", "session.snapshot")
        reader = sock.makefile("rb")
        for line in reader:
            reply = json.loads(line)
            if not isinstance(reply, dict) or reply.get("id") != "spaces-snapshot":
                continue
            result = reply.get("result")
            snap = result.get("snapshot") if isinstance(result, dict) else None
            return snap if isinstance(snap, dict) else None
    return None


def dicts(items):
    # The objects in `items`, or none when it is not a list: the reply comes
    # from another program, so nothing about its shape is taken on trust.
    return [item for item in items if isinstance(item, dict)] if isinstance(items, list) else []


# Limits on what is passed on from Herdr's free-form fields. Everything in
# them comes from other programs, so it is cut down to short plain strings.
MAX_TOKENS = 8
MAX_TOKEN_KEY = 24
MAX_TOKEN_VALUE = 40
MAX_ACTIVITY = 160
MAX_CWD = 512
# Token keys the widget knows how to show, kept first when there are too many.
KNOWN_TOKENS = ("model", "ctx", "cost", "branch")


def text(value, limit):
    # A short single-line string, or "" for anything that is not text.
    if isinstance(value, bool) or not isinstance(value, (str, int, float)):
        return ""
    value = " ".join(str(value).split())
    return value[:limit - 1] + "\u2026" if len(value) > limit else value


def tokens_of(raw):
    if not isinstance(raw, dict):
        return {}
    keys = [k for k in raw if isinstance(k, str) and 0 < len(k) <= MAX_TOKEN_KEY]
    keys.sort(key=lambda k: (KNOWN_TOKENS.index(k) if k in KNOWN_TOKENS else len(KNOWN_TOKENS), k))
    out = {}
    for key in keys:
        value = text(raw[key], MAX_TOKEN_VALUE)
        if value:
            out[key] = value
        if len(out) >= MAX_TOKENS:
            break
    return out


def cwd_of(value):
    # A path is left as it is: cut short or squeezed, it would name another one.
    return value if isinstance(value, str) and len(value) <= MAX_CWD and "\n" not in value else ""


def activity_of(labels, status):
    if not isinstance(labels, dict) or not isinstance(status, str):
        return ""
    return text(labels.get(status), MAX_ACTIVITY)


class Since:
    # When each pane entered its current status, as first seen by this
    # process. Herdr has no timestamp for it, so this is the best there is.
    def __init__(self):
        self.seen = {}

    def stamp(self, pane_id, status, now=None):
        now = int(time.time()) if now is None else now
        last = self.seen.get(pane_id)
        if last is None or last[0] != status:
            last = (status, now)
            self.seen[pane_id] = last
        return last[1]

    def forget_except(self, pane_ids):
        for pane_id in list(self.seen):
            if pane_id not in pane_ids:
                del self.seen[pane_id]


SINCE = Since()


def normalize(snap, since=SINCE):
    workspaces = {w.get("workspace_id"): w for w in dicts(snap.get("workspaces"))}
    # Only the agents list carries Herdr's change counter, not the panes; it
    # also repeats state labels and tokens, used when a pane lacks them.
    by_pane = {str(a.get("pane_id")): a for a in dicts(snap.get("agents"))}
    changes = {pane_id: a.get("state_change_seq") for pane_id, a in by_pane.items()}
    agents = []
    for pane in dicts(snap.get("panes")):
        status = pane.get("agent_status") or "unknown"
        # A plain shell pane: nothing for the bar to say about it.
        if pane.get("agent") is None and status == "unknown":
            continue
        workspace = workspaces.get(pane.get("workspace_id")) or {}
        session = pane.get("agent_session")
        session = session if isinstance(session, dict) else {}
        extra = by_pane.get(str(pane.get("pane_id"))) or {}
        labels = pane.get("state_labels") if isinstance(pane.get("state_labels"), dict) else extra.get("state_labels")
        tokens = pane.get("tokens") if isinstance(pane.get("tokens"), dict) else extra.get("tokens")
        agents.append({
            "pane_id": pane.get("pane_id"),
            "workspace_id": pane.get("workspace_id"),
            "workspace_label": workspace.get("label") or "",
            "workspace_number": workspace.get("number") or 0,
            "tab_id": pane.get("tab_id"),
            "agent": pane.get("agent"),
            "status": status,
            "title": pane.get("terminal_title_stripped") or pane.get("terminal_title") or "",
            "focused": pane.get("focused") is True,
            "session": session.get("value") or "",
            "state_change": changes.get(str(pane.get("pane_id"))) or 0,
            "activity": activity_of(labels, status),
            "tokens": tokens_of(tokens),
            "cwd": cwd_of(pane.get("cwd") or extra.get("cwd")),
            "since": since.stamp(str(pane.get("pane_id")), status),
        })
    since.forget_except({str(a["pane_id"]) for a in agents})
    return {"type": "herdr", "agents": agents,
            "focused_workspace_id": snap.get("focused_workspace_id")}


class Printer:
    # Only print when something changed: titles and focus move often, but a
    # repeat of the last line would only wake the widget for nothing.
    def __init__(self):
        self.last = None

    def emit(self, snap):
        line = json.dumps(normalize(snap), separators=(",", ":"))
        if line == self.last:
            return
        self.last = line
        sys.stdout.write(line + "\n")
        sys.stdout.flush()


def relevant(line):
    try:
        message = json.loads(line)
    except ValueError:
        return False
    if not isinstance(message, dict):
        return False
    return str(message.get("event") or "").replace(".", "_") in RELEVANT


def watch(printer):
    with connect() as sock:
        send(sock, "spaces-events", "events.subscribe",
             {"subscriptions": [{"type": kind} for kind in EVENTS]})
        # Subscribe before the first snapshot so no change slips in between.
        snap = snapshot()
        last = time.monotonic()
        if snap is not None:
            printer.emit(snap)
        buffer = b""
        due = None
        while True:
            wait = None if due is None else max(0.0, due - time.monotonic())
            ready, _, _ = select.select([sock], [], [], wait)
            if ready:
                chunk = sock.recv(65536)
                if not chunk:
                    return  # Herdr closed the connection.
                lines = (buffer + chunk).split(b"\n")
                buffer = lines.pop()
                if due is None and any(relevant(line) for line in lines):
                    due = max(time.monotonic() + DEBOUNCE, last + MIN_GAP)
            if due is not None and time.monotonic() >= due:
                due = None
                snap = snapshot()
                last = time.monotonic()
                if snap is not None:
                    printer.emit(snap)


# The demo script: (agent, workspace label, workspace number, title, model,
# branch) and one Herdr status per two-second step. Every step has a live
# agent, so the chip stays up, and every badge shows at some point in the loop.
DEMO_AGENTS = [
    ("claude", "api", 1, "fix flaky checkout test", "opus", "fix/checkout-flake"),
    ("codex", "web", 2, "migrate auth middleware", "gpt-5", "auth-middleware"),
    ("opencode", "docs", 3, "write release notes", "sonnet", "main"),
    ("claude", "infra", 4, "bump terraform providers", "opus", "deps/terraform"),
]
DEMO_STEPS = [
    "working working working working done done done idle idle working",
    "working working blocked blocked blocked working working working done done",
    "done done idle idle working working working blocked blocked working",
    "idle working working working working working done done idle idle",
]
# What each agent is busy with, per status, as Herdr's state labels say it.
DEMO_ACTIVITY = [
    {"working": "running: npm test -- checkout", "blocked": "permission: Bash"},
    {"working": "editing src/middleware/auth.ts", "blocked": "approve edit to src/middleware/auth.ts?"},
    {"working": "reading CHANGELOG.md", "blocked": "which version is this release?"},
    {"working": "running: terraform plan", "blocked": "permission: terraform apply"},
]
# A head start, in seconds, added to the time in each status, so screenshots
# show minutes and hours as well as seconds.
DEMO_AGE = [35, 240, 4320, 600]
DEMO_STEP = 2.0


def demo_snapshot(step, changes, entered):
    agents = []
    for i, (agent, label, number, title, model, branch) in enumerate(DEMO_AGENTS):
        steps = DEMO_STEPS[i].split()
        status = steps[step % len(steps)]
        agents.append({
            "pane_id": "demo:p%d" % (i + 1),
            "workspace_id": "demo:w%d" % number,
            "workspace_label": label,
            "workspace_number": number,
            "tab_id": "demo:t%d" % (i + 1),
            "agent": agent,
            "status": status,
            "title": title,
            "focused": False,
            "session": "",
            "state_change": changes[i],
            "activity": DEMO_ACTIVITY[i].get(status, ""),
            # Context and cost grow through the loop and start over with it.
            "tokens": {"model": model, "ctx": "%d%%" % (12 + 7 * i + 3 * (step % len(steps))),
                       "cost": "$%.2f" % (0.4 + 1.3 * i + 0.11 * (step % len(steps))), "branch": branch},
            "cwd": "/home/demo/src/%s" % label,
            "since": entered[i] - DEMO_AGE[i],
        })
    return {"type": "herdr", "demo": True, "agents": agents, "focused_workspace_id": None}


def demo():
    # The same statuses in the same order on every run. The change counter
    # grows like Herdr's, so the newest change sorts first; `since` is the
    # real time each agent entered its status, less its head start.
    last = [None] * len(DEMO_AGENTS)
    changes = [0] * len(DEMO_AGENTS)
    entered = [0] * len(DEMO_AGENTS)
    seq = 0
    step = 0
    printed = None
    while True:
        now = int(time.time())
        for i in range(len(DEMO_AGENTS)):
            status = DEMO_STEPS[i].split()[step % len(DEMO_STEPS[i].split())]
            if status != last[i]:
                seq += 1
                changes[i] = seq
                entered[i] = now
                last[i] = status
        line = json.dumps(demo_snapshot(step, changes, entered), separators=(",", ":"))
        if line != printed:
            printed = line
            sys.stdout.write(line + "\n")
            sys.stdout.flush()
        if "--once" in sys.argv[1:]:
            return
        step += 1
        time.sleep(DEMO_STEP)


def main():
    # The widget closing our stdout is a normal way to stop.
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    printer = Printer()
    try:
        if "--demo" in sys.argv[1:]:
            demo()
        elif "--once" in sys.argv[1:]:
            snap = snapshot()
            if snap is not None:
                printer.emit(snap)
        else:
            watch(printer)
    except (Exception, KeyboardInterrupt):
        # Missing or refused socket, Herdr going away mid-request, or a reply
        # of a shape this script does not know: say nothing. The widget
        # retries on its own schedule.
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
