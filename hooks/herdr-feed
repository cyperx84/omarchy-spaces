#!/usr/bin/env python3
# Herdr agent status feed for the Spaces bar widget.
#
# Herdr is a terminal multiplexer that already knows what every coding agent
# in its panes is doing, so instead of a reporter hook per agent the widget
# listens to Herdr itself. This script holds Herdr's socket open, and on
# startup and after every relevant event prints one JSON line to stdout:
#
#   {"type": "herdr", "focused_workspace_id": "w35",
#    "agents": [{"pane_id", "workspace_id", "workspace_label",
#                "workspace_number", "tab_id", "agent", "status", "title",
#                "focused", "session", "state_change"}]}
#
# `status` is Herdr's agent_status verbatim (idle | working | blocked | done |
# unknown); the widget decides what earns a badge. `state_change` is Herdr's
# state_change_seq for the agent (higher is more recent, 0 when unknown), so
# the widget can list the newest change first. Only panes running an agent
# are listed.
#
# Herdr not installed or not running is not an error: the script exits 0
# quietly and the widget tries again later. It also exits 0 when the server
# goes away. Pass --once to print a single snapshot and exit.
#
# Pass --demo for screenshots: no socket at all, just four made-up agents
# going through working, blocked, done and idle on a fixed 20 second loop.
# Its lines carry "demo": true, and the widget only accepts those while its
# `demo` setting is on (and never otherwise).
#
# Stdlib only, so it runs anywhere python3 does.

import json
import os
import select
import signal
import socket
import sys
import time

# Events that can change an agent's status, title or workspace. Payloads are
# ignored: each burst just triggers a fresh snapshot, which is simpler and
# can never drift from what Herdr shows. (pane.agent_status_changed needs a
# pane_id to subscribe, so pane.updated stands in for it.)
EVENTS = [
    "workspace.created", "workspace.updated", "workspace.renamed",
    "workspace.moved", "workspace.reordered", "workspace.closed",
    "pane.created", "pane.updated", "pane.moved", "pane.closed",
    "pane.exited", "pane.agent_detected",
]
# The stream spells kinds with underscores (pane_updated); compare that way.
RELEVANT = {kind.replace(".", "_") for kind in EVENTS}

# Events arrive in bursts (subscribing alone replays a backlog). The first
# event opens a short window; everything inside it shares one snapshot.
DEBOUNCE = 0.15
# A working agent updates its pane about ten times a second (the title
# spinner), so snapshots are also kept at least this far apart.
MIN_GAP = 1.0


def socket_path():
    return os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser("~/.config/herdr/herdr.sock")


def connect():
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(socket_path())
    return sock


def send(sock, request_id, method, params=None):
    message = {"id": request_id, "method": method, "params": params or {}}
    sock.sendall((json.dumps(message) + "\n").encode())


def snapshot():
    # One short-lived connection per request keeps replies out of the event
    # stream. Returns None when Herdr answers with an error.
    with connect() as sock:
        sock.settimeout(5)
        send(sock, "spaces-snapshot", "session.snapshot")
        reader = sock.makefile("rb")
        for line in reader:
            reply = json.loads(line)
            if not isinstance(reply, dict) or reply.get("id") != "spaces-snapshot":
                continue
            result = reply.get("result")
            snap = result.get("snapshot") if isinstance(result, dict) else None
            return snap if isinstance(snap, dict) else None
    return None


def dicts(items):
    # The objects in `items`, or none when it is not a list: the reply comes
    # from another program, so nothing about its shape is taken on trust.
    return [item for item in items if isinstance(item, dict)] if isinstance(items, list) else []


def normalize(snap):
    workspaces = {w.get("workspace_id"): w for w in dicts(snap.get("workspaces"))}
    # Only the agents list carries Herdr's change counter, not the panes.
    changes = {a.get("pane_id"): a.get("state_change_seq") for a in dicts(snap.get("agents"))}
    agents = []
    for pane in dicts(snap.get("panes")):
        status = pane.get("agent_status") or "unknown"
        # A plain shell pane: nothing for the bar to say about it.
        if pane.get("agent") is None and status == "unknown":
            continue
        workspace = workspaces.get(pane.get("workspace_id")) or {}
        session = pane.get("agent_session")
        session = session if isinstance(session, dict) else {}
        agents.append({
            "pane_id": pane.get("pane_id"),
            "workspace_id": pane.get("workspace_id"),
            "workspace_label": workspace.get("label") or "",
            "workspace_number": workspace.get("number") or 0,
            "tab_id": pane.get("tab_id"),
            "agent": pane.get("agent"),
            "status": status,
            "title": pane.get("terminal_title_stripped") or pane.get("terminal_title") or "",
            "focused": pane.get("focused") is True,
            "session": session.get("value") or "",
            "state_change": changes.get(pane.get("pane_id")) or 0,
        })
    return {"type": "herdr", "agents": agents,
            "focused_workspace_id": snap.get("focused_workspace_id")}


class Printer:
    # Only print when something changed: titles and focus move often, but a
    # repeat of the last line would only wake the widget for nothing.
    def __init__(self):
        self.last = None

    def emit(self, snap):
        line = json.dumps(normalize(snap), separators=(",", ":"))
        if line == self.last:
            return
        self.last = line
        sys.stdout.write(line + "\n")
        sys.stdout.flush()


def relevant(line):
    try:
        message = json.loads(line)
    except ValueError:
        return False
    if not isinstance(message, dict):
        return False
    return str(message.get("event") or "").replace(".", "_") in RELEVANT


def watch(printer):
    with connect() as sock:
        send(sock, "spaces-events", "events.subscribe",
             {"subscriptions": [{"type": kind} for kind in EVENTS]})
        # Subscribe before the first snapshot so no change slips in between.
        snap = snapshot()
        last = time.monotonic()
        if snap is not None:
            printer.emit(snap)
        buffer = b""
        due = None
        while True:
            wait = None if due is None else max(0.0, due - time.monotonic())
            ready, _, _ = select.select([sock], [], [], wait)
            if ready:
                chunk = sock.recv(65536)
                if not chunk:
                    return  # Herdr closed the connection.
                lines = (buffer + chunk).split(b"\n")
                buffer = lines.pop()
                if due is None and any(relevant(line) for line in lines):
                    due = max(time.monotonic() + DEBOUNCE, last + MIN_GAP)
            if due is not None and time.monotonic() >= due:
                due = None
                snap = snapshot()
                last = time.monotonic()
                if snap is not None:
                    printer.emit(snap)


# The demo script: (agent, workspace label, workspace number, title) and one
# Herdr status per two-second step. Every step has a live agent, so the chip
# stays up, and every badge shows at some point in the loop.
DEMO_AGENTS = [
    ("claude", "api", 1, "fix flaky checkout test"),
    ("codex", "web", 2, "migrate auth middleware"),
    ("opencode", "docs", 3, "write release notes"),
    ("claude", "infra", 4, "bump terraform providers"),
]
DEMO_STEPS = [
    "working working working working done done done idle idle working",
    "working working blocked blocked blocked working working working done done",
    "done done idle idle working working working blocked blocked working",
    "idle working working working working working done done idle idle",
]
DEMO_STEP = 2.0


def demo_snapshot(step, changes):
    agents = []
    for i, (agent, label, number, title) in enumerate(DEMO_AGENTS):
        steps = DEMO_STEPS[i].split()
        agents.append({
            "pane_id": "demo:p%d" % (i + 1),
            "workspace_id": "demo:w%d" % number,
            "workspace_label": label,
            "workspace_number": number,
            "tab_id": "demo:t%d" % (i + 1),
            "agent": agent,
            "status": steps[step % len(steps)],
            "title": title,
            "focused": False,
            "session": "",
            "state_change": changes[i],
        })
    return {"type": "herdr", "demo": True, "agents": agents, "focused_workspace_id": None}


def demo():
    # Deterministic: the same lines in the same order on every run. The
    # change counter grows like Herdr's, so the newest change sorts first.
    last = [None] * len(DEMO_AGENTS)
    changes = [0] * len(DEMO_AGENTS)
    seq = 0
    step = 0
    printed = None
    while True:
        for i in range(len(DEMO_AGENTS)):
            status = DEMO_STEPS[i].split()[step % len(DEMO_STEPS[i].split())]
            if status != last[i]:
                seq += 1
                changes[i] = seq
                last[i] = status
        line = json.dumps(demo_snapshot(step, changes), separators=(",", ":"))
        if line != printed:
            printed = line
            sys.stdout.write(line + "\n")
            sys.stdout.flush()
        if "--once" in sys.argv[1:]:
            return
        step += 1
        time.sleep(DEMO_STEP)


def main():
    # The widget closing our stdout is a normal way to stop.
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    printer = Printer()
    try:
        if "--demo" in sys.argv[1:]:
            demo()
        elif "--once" in sys.argv[1:]:
            snap = snapshot()
            if snap is not None:
                printer.emit(snap)
        else:
            watch(printer)
    except (Exception, KeyboardInterrupt):
        # Missing or refused socket, Herdr going away mid-request, or a reply
        # of a shape this script does not know: say nothing. The widget
        # retries on its own schedule.
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
